USE MushuAirlines;

CREATE OR ALTER TRIGGER trg_PreventOverbooking
ON Ticket
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS (
        SELECT 1
        FROM (
            SELECT
                (a.EconomyRows    * a.EconomySeatsPerRow
               + a.FirstClassRows * a.FirstClassSeatsPerRow) AS Capacity,
                (SELECT COUNT(*) FROM Ticket t WHERE t.ScheduledId = sf.Id) AS TotalBooked
            FROM  (SELECT DISTINCT ScheduledId FROM inserted) i
            JOIN  ScheduledFlight sf ON sf.Id   = i.ScheduledId
            JOIN  Aircraft        a  ON a.Code  = sf.AircraftCode
        ) capacity_check
        WHERE capacity_check.Capacity > 0
          AND capacity_check.TotalBooked > capacity_check.Capacity
    )
    BEGIN
        ROLLBACK TRANSACTION;
        THROW 50001,
              N'No se puede registrar el ticket: el vuelo ha superado la capacidad máxima de la aeronave.',
              1;
    END
END;
