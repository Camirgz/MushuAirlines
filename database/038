USE MushuAirlines;
GO

CREATE TABLE BaggageAdditionStaging (
    SessionId        UNIQUEIDENTIFIER NOT NULL,
    PassengerId      INT              NOT NULL,
    ExtraCheckedBags INT              NOT NULL,
    UnitPrice        DECIMAL(10,2)    NOT NULL
);
go

CREATE OR ALTER PROCEDURE AddBaggageToReservation
(
    @ReservationCode NVARCHAR(20),
    @SessionId       UNIQUEIDENTIFIER
)
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    BEGIN TRANSACTION;

    BEGIN TRY

        DECLARE @BookingCode INT, @PurchaseId INT;

        SELECT @BookingCode = p.BookingCode, @PurchaseId = p.Id
        FROM   Purchase p
        JOIN   Itinerary i ON i.BookingCode = p.BookingCode
        WHERE  p.ReservationCode = @ReservationCode
          AND  ISNULL(i.Status, '') <> 'Cancelled';

        IF @BookingCode IS NULL
        BEGIN
            RAISERROR('Reserva no encontrada o cancelada.', 16, 1);
            RETURN;
        END

        IF EXISTS (
            SELECT 1 FROM BaggageAdditionStaging s
            WHERE  s.SessionId = @SessionId
              AND  NOT EXISTS (
                SELECT 1 FROM TicketBaggage
                WHERE BookingCode = @BookingCode AND PassengerId = s.PassengerId))
        BEGIN
            RAISERROR('Uno o más pasajeros no pertenecen a esta reserva.', 16, 1);
            RETURN;
        END

        UPDATE tb
        SET    tb.CheckedBagCount = tb.CheckedBagCount + s.ExtraCheckedBags,
               tb.BaggageSubtotal = tb.BaggageSubtotal + (s.ExtraCheckedBags * s.UnitPrice)
        FROM   TicketBaggage tb
        JOIN   BaggageAdditionStaging s ON s.PassengerId = tb.PassengerId
        WHERE  tb.BookingCode = @BookingCode
          AND  s.SessionId    = @SessionId
          AND  s.ExtraCheckedBags > 0;

        UPDATE Purchase
        SET    TotalPaid = TotalPaid + (
                   SELECT SUM(ExtraCheckedBags * UnitPrice)
                   FROM   BaggageAdditionStaging
                   WHERE  SessionId = @SessionId)
        WHERE  Id = @PurchaseId;

        IF EXISTS (SELECT 1 FROM PurchaseBaggageDetail WHERE PurchaseId = @PurchaseId AND BaggageType = 'CheckedBaggage')
            UPDATE PurchaseBaggageDetail
            SET    Quantity = Quantity + (SELECT SUM(ExtraCheckedBags) FROM BaggageAdditionStaging WHERE SessionId = @SessionId),
                   Subtotal = Subtotal + (SELECT SUM(ExtraCheckedBags * UnitPrice) FROM BaggageAdditionStaging WHERE SessionId = @SessionId)
            WHERE  PurchaseId = @PurchaseId AND BaggageType = 'CheckedBaggage';
        ELSE
            INSERT INTO PurchaseBaggageDetail (PurchaseId, BaggageType, Quantity, UnitPrice, Subtotal)
            SELECT @PurchaseId, 'CheckedBaggage',
                   SUM(ExtraCheckedBags), MAX(UnitPrice), SUM(ExtraCheckedBags * UnitPrice)
            FROM   BaggageAdditionStaging
            WHERE  SessionId = @SessionId AND ExtraCheckedBags > 0;

        DELETE FROM BaggageAdditionStaging WHERE SessionId = @SessionId;

        COMMIT TRANSACTION;

    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END
