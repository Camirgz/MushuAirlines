CREATE TABLE [User] (
    Id INT PRIMARY KEY
);

CREATE TABLE Person (
    Id INT PRIMARY KEY,
    FirstName VARCHAR(255),
    LastName VARCHAR(255),
    Ssn VARCHAR(255),
    Nationality VARCHAR(255)
);

CREATE TABLE ExternalSystChecksFlight (
    FlightId VARCHAR(255),
    ExternalSystemId VARCHAR(255),
    PRIMARY KEY (FlightId, ExternalSystemId)
);

CREATE TABLE System (
    Url VARCHAR(255) PRIMARY KEY,
    Layover VARCHAR(255),
    Schedule VARCHAR(255),
    Route VARCHAR(255),
    AircraftType VARCHAR(100),
);

CREATE TABLE Employee (
    Id INT PRIMARY KEY,
    Url VARCHAR(255),
    Salary FLOAT,
    WorkSchedule VARCHAR(255),
    Permissions VARCHAR(255)
);

CREATE TABLE AccountEmployee (
    Id int,
    Account varchar(255),
    Username varchar(255) unique NOT NULL,
    password varchar(255) NOT NULL,
    PRIMARY KEY (Id, Account),

    CONSTRAINT Fk_AccountEmployee
        FOREIGN KEY (Id) 
        REFERENCES Employee(Id)
);

CREATE TABLE Operator (
    Id int PRIMARY KEY,
    CONSTRAINT FK_OperatorEmployee
        FOREIGN KEY (Id) 
        REFERENCES Employee(Id)
);

CREATE TABLE Administrator (
    Id int PRIMARY KEY,
    CONSTRAINT FK_AdminEmployee
        FOREIGN KEY (Id) 
        REFERENCES Employee(Id)
);

CREATE TABLE AircraftType (
    Id INT NOT NULL,
    AircraftType VARCHAR(100) NOT NULL,

    CONSTRAINT PK_AircraftType
	PRIMARY KEY (id)
);

CREATE TABLE Aircraft (
    Code INT NOT NULL,
    EconomyRows INT NOT NULL,
    FirstClassRows INT NOT NULL,
    MaxTakeOffWeight FLOAT NOT NULL,
    Model VARCHAR(100) NOT NULL,
    [Type] INT NOT NULL,

    CONSTRAINT PK_Aircraft
	PRIMARY KEY (code),

    CONSTRAINT FK_AircraftType
	FOREIGN KEY (type)
	REFERENCES AircraftType (id)
);

CREATE TABLE FlightSchedule (
    Id INT NOT NULL,
    PassengerBooked INT NULL,
    OriginAirport VARCHAR(3) NOT NULL,
    DestinationAirport VARCHAR(3) NOT NULL,
    Duration VARCHAR(20) NOT NULL,
    DepartureTime TIME NOT NULL,
    ArrivalTime TIME NOT NULL,
    DepartureDate DATE NOT NULL,
    ArrivalDate DATE NOT NULL,

    CONSTRAINT PK_FlightSchedule           
	PRIMARY KEY (id),

    CONSTRAINT FK_FS_Passenger              
	FOREIGN KEY (passengerBooked)
    REFERENCES Passenger (id),

    CONSTRAINT FK_FS_OriginAirport         
	FOREIGN KEY (originAirport)
    REFERENCES Airport (code),

    CONSTRAINT FK_FS_Destination_Airport
	FOREIGN KEY (destinationAirport)
    REFERENCES Airport (code)
);

CREATE TABLE Manages (
    OperadorId INT NOT NULL,
    AdministradorId INT NOT NULL,
    FlightId INT NOT NULL,

    CONSTRAINT PK_Manages               
	PRIMARY KEY (OperadorId, AdministradorId, FlightId),

    CONSTRAINT FK_Manages_Operator      
	FOREIGN KEY (OperadorId)
    REFERENCES Operator (id),

    CONSTRAINT FK_Manages_Administrator 
	FOREIGN KEY (AdministradorId)
    REFERENCES Administrator (id),

    CONSTRAINT FK_Manages_Flight        
	FOREIGN KEY (FlightId)
    REFERENCES FlightSchedule (id)
);

CREATE TABLE ExternalSystChecksFlight (
    FlightId INT NOT NULL,
    ExternalSystemId INT NOT NULL,

    CONSTRAINT PK_ExtSystChecksFlight           
	PRIMARY KEY (FlightId, ExternalSystemId),

    CONSTRAINT FK_ESCF_Scheduled_Flight         
	FOREIGN KEY (FlightId)
    REFERENCES ScheduledFlight (id),

    CONSTRAINT FK_ESCF_External_System          
	FOREIGN KEY (ExternalSystemId)
    REFERENCES ExternalSystem (id)
);

CREATE TABLE FlightScheduleHasScheduledFlight (
	FlightScheduleId INT NOT NULL,
	ScheduledFlightId INT NOT NULL,

	CONSTRAINT PK_FlightScheduleScheduledFlight
	PRIMARY KEY (FlightScheduleId, ScheduledFlightId),

	CONSTRAINT FK_Flight_Schedule
	FOREIGN KEY (FlightScheduleId)
	REFERENCES FlightSchedule(Id),

	CONSTRAINT FK_Scheduled_Flight
	FOREIGN KEY (ScheduledFlightId)
	REFERENCES ScheduledFlight(Id)
);

CREATE TABLE Airport (
    Code VARCHAR(3) NOT NULL CHECK (LEN(Code) = 3),
    AirportName VARCHAR(200) NOT NULL,
    Country VARCHAR(60) NOT NULL,
    City VARCHAR(85) NOT NULL,

    CONSTRAINT PK_Airport PRIMARY KEY (Code)
);

