CREATE PROCEDURE DeleteEmployee
    @id INT
AS
BEGIN
    BEGIN TRANSACTION;
    BEGIN TRY
        DECLARE @IsLinkedToAirport BIT = 0;

        IF EXISTS (SELECT 1 FROM AdminAirport WHERE AdministratorId = @id)
            SET @IsLinkedToAirport = 1;

        IF @IsLinkedToAirport = 0
        BEGIN
            DELETE FROM AccountEmployee WHERE Id = @id;
            DELETE FROM PendingAccount WHERE EmployeeId = @id;
            DELETE FROM Manages WHERE OperadorId = @id OR AdministradorId = @id;
            DELETE FROM AdminAirport WHERE AdministratorId = @id;
            DELETE FROM Operator WHERE Id = @id;
            DELETE FROM Administrator WHERE Id = @id;
            DELETE FROM Employee WHERE Id = @id;
            DELETE FROM Person WHERE Id = @id;
            DELETE FROM [User] WHERE Id = @id;
        END
        ELSE
        BEGIN
            UPDATE Employee
            SET IsDeleted = 1
            WHERE Id = @id;
        END

        COMMIT;
    END TRY
    BEGIN CATCH
        ROLLBACK;
        THROW;
    END CATCH;
END;