ADD IsDeleted BIT NOT NULL DEFAULT (0);
GO

-- Auxiliar Function
CREATE OR ALTER FUNCTION RouteHasPurchases
(
    @RouteCode VARCHAR(100)
)
RETURNS BIT
AS
BEGIN
    DECLARE @HasPurchase BIT = 0;
    DECLARE @NormalizedRouteCode VARCHAR(100);

    SET @NormalizedRouteCode = UPPER(@RouteCode);

    IF EXISTS (
        SELECT 1
        FROM Purchase p
        INNER JOIN ItineraryScheduledFlight isf
            ON isf.BookingCode = p.BookingCode
        INNER JOIN ScheduledFlight sf
            ON sf.Id = ScheduledId
        WHERE UPPER(sf.RouteCode) = @NormalizedRouteCode
    )
    BEGIN
        SET @HasPurchase = 1;
    END;

    RETURN @HasPurchase;
END;
GO

CREATE OR ALTER PROCEDURE HardDeleteRouteData
    @RouteCode VARCHAR(100)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @NormalizedRouteCode VARCHAR(100);

    SET @NormalizedRouteCode = UPPER(@RouteCode);

    DECLARE @ScheduledFlights TABLE (Id INT PRIMARY KEY);
    DECLARE @FlightSchedules TABLE (Id INT PRIMARY KEY);

    INSERT INTO @ScheduledFlights (Id)
    SELECT Id
    FROM ScheduledFlight
    WHERE UPPERRouteCode) = @NormalizedRouteCode;

    INSERT INTO @FlightSchedules (Id)
    SELECT DISTINCT fshsf.FlightScheduleId
    FROM FlightScheduleHasScheduledFlight fshsf
    INNER JOIN @ScheduledFlights sf
        ON sf.Id = ScheduledFlightId;

    DELETE tb
    FROM TicketBaggage tb
    INNER JOIN @ScheduledFlights sf
        ON sf.Id = tb.ScheduledFlightId;

    DELETE t
    FROM Ticket t
    INNER JOIN @ScheduledFlights sf
        ON sf.Id = t.ScheduledId;

    DELETE isf
    FROM ItineraryScheduledFlight isf
    INNER JOIN @ScheduledFlights sf
        ON sf.Id = isf.ScheduledId;

    DELETE aps
    FROM AirportScheduled aps
    INNER JOIN @ScheduledFlights sf
        ON sf.Id = aps.ScheduledFlightId;

    DELETE fshsf
    FROM FlightScheduleHasScheduledFlight fshsf
    INNER JOIN @ScheduledFlights sf
        ON sf.Id = fshsf.ScheduledFlightId;

    DELETE m
    FROM Manages m
    INNER JOIN @FlightSchedules fs
        ON fs.Id = m.FlightId;

    DELETE escf
    FROM ExternalSystChecksFlight escf
    INNER JOIN @FlightSchedules fs
        ON fs.Id = escf.FlightId;

    DELETE fs
    FROM FlightSchedule fs
    INNER JOIN @FlightSchedules f
        ON f.Id = fs.Id;

    DELETE sf
    FROM ScheduledFlight sf
    INNER JOIN @ScheduledFlights s
        ON s.Id = sf.Id;

    DELETE FROM Route
    WHERE UPPER(Code) = @NormalizedRouteCode;
END;
GO
